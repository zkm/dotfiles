.DS_Store
.cache
cache

# OpenRGB generated artifacts
config/OpenRGB/logs/
config/OpenRGB/__pycache__/
config/OpenRGB/.venv/
config/OpenRGB/OpenRGB.json.bak*

# Local license/registration artifacts
config/REAPER/reaper-license.rk
config/REAPER/reaper-reginfo2.ini

# Runtime/cache artifacts from synced app configs
config/btop/btop.log
config/gtk-3.0/settings.ini.*

# KDE Plasma configs — not managed by this repo, drift too fast from live state
config/dolphinrc
config/kcminputrc
config/kdeglobals
config/plasma-org.kde.plasma.desktop-appletsrc
config/plasmanotifyrc
config/plasmarc
config/REAPER/MetadataCaches/
config/REAPER/ReaPack/
config/REAPER/reaper-recentfx.ini
*.pyc

# GIMP regenerable caches / session-machine-specific state
config/GIMP/*/pluginrc
config/GIMP/*/tags.xml
config/GIMP/*/devicerc
config/GIMP/*/action-history
config/GIMP/*/tmp/
config/GIMP/*/backups/
config/GIMP/*/CrashLog/
config/GIMP/*/plug-in-settings/
config/GIMP/*/internal-data/
config/GIMP/*/filters/
config/GIMP/*/templaterc
config/GIMP/*/profilerc
config/GIMP/*/extensionrc

# Generic temp/editor artifacts
.vscode/
*.tmp
*.temp
*.swp
*.swo
*~

# Local backup snapshots
backups/

# Machine-specific aliases
aliases.local
config/fish/aliases.local.fish

# fish's own auto-generated universal-variable state — written directly into
# this directory because ~/.config/fish is symlinked here, same class of
# problem as KDE Plasma's live desktop-state churn (see docs/decisions.md).
config/fish/fish_variables

# pipx-generated launchers (chirp, wxPython tools): absolute symlinks into
# ~/.local/share/pipx/venvs on one machine. pipx already exposes them in
# ~/.local/bin, so they are not tracked here.
local/bin/chirp
local/bin/chirpc
local/bin/experttune
local/bin/helpviewer
local/bin/img2png
local/bin/img2py
local/bin/img2xpm
local/bin/pycrust
local/bin/pyshell
local/bin/pyslices
local/bin/pyslicesshell
local/bin/pywxrc
local/bin/wxdemo
local/bin/wxdocs
local/bin/wxget
