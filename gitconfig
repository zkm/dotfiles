[user]
	email = me@zachschneider.com
	name = Zach Schneider
[credential]
	# In-memory only; no plaintext ~/.git-credentials. A persistent, OS-specific
	# helper (libsecret on Linux) goes in ~/.gitconfig.local, included below.
	helper = cache --timeout=28800
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[sendemail]
	smtpServer = smtp.protonmail.ch
	smtpServerPort = 587
	smtpEncryption = tls
	smtpUser = me@zachschneider.com
	from = Zach Schneider <me@zachschneider.com>
	confirm = always
# Drupal GitLab repos use the drupalcode noreply address; everything else uses the [user] email above
# scp-style URLs need ":*/**": a bare ":**" after ":" acts like "*" and never matches the "/" in project/foo.git
[includeIf "hasconfig:remote.*.url:git@git.drupal.org:*/**"]
	path = ~/.gitconfig-drupal
[includeIf "hasconfig:remote.*.url:git@git.drupalcode.org:*/**"]
	path = ~/.gitconfig-drupal
[includeIf "hasconfig:remote.*.url:https://git.drupalcode.org/**"]
	path = ~/.gitconfig-drupal
[includeIf "hasconfig:remote.*.url:ssh://git@git.drupal.org/**"]
	path = ~/.gitconfig-drupal
[includeIf "hasconfig:remote.*.url:ssh://git@git.drupalcode.org/**"]
	path = ~/.gitconfig-drupal
# Machine-specific overrides (not tracked), e.g.:
#   [credential]
#   	helper = /usr/lib/git-core/git-credential-libsecret
[include]
	path = ~/.gitconfig.local
