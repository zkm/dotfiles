# https://ghostty.org/docs/config

# Colors match kitty/alacritty/wezterm (noctalia — see
# config/kitty/themes/noctalia.conf for the canonical hex values).
background = #111418
foreground = #e1e2e8
selection-background = #43474e
selection-foreground = #c3c6cf
cursor-color = #e1e2e8

palette = 0=#43474e
palette = 1=#ffb4ab
palette = 2=#a3c9fe
palette = 3=#bcc7db
palette = 4=#d8bde3
palette = 5=#a3c9fe
palette = 6=#bcc7db
palette = 7=#e1e2e8
palette = 8=#8d9199
palette = 9=#ffb4ab
palette = 10=#a3c9fe
palette = 11=#bcc7db
palette = 12=#d8bde3
palette = 13=#a3c9fe
palette = 14=#bcc7db
palette = 15=#e1e2e8

font-family = MesloLGS NF
font-size = 12
gtk-titlebar = true

cursor-style = block
cursor-text = #111418
cursor-style-blink = true

window-width = 120
window-height = 40
window-padding-x = 8
window-padding-y = 8

confirm-close-surface = true
scrollback-limit = 4000000
background-opacity = 0.95
working-directory = home
selection-word-chars = "\t'\"│`|:;,()[]{}<>$"

# splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+arrow_left=goto_split:left
keybind = super+arrow_right=goto_split:right
keybind = super+arrow_up=goto_split:up
keybind = super+arrow_down=goto_split:down
keybind = alt+arrow_left=resize_split:left,10
keybind = alt+arrow_right=resize_split:right,10
keybind = alt+arrow_up=resize_split:up,10
keybind = alt+arrow_down=resize_split:down,10
